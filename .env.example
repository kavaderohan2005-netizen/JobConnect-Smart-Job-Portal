# ==========================================
# JobConnect Configuration
# ==========================================

SECRET_KEY=jobconnect-smart-portal-secret-key-2026

# MySQL Configuration
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=jobconnect_db

# DB_TYPE: 'auto' (tries MySQL first, falls back to SQLite if MySQL is offline),
# or force 'mysql' / 'sqlite'
DB_TYPE=auto

FLASK_ENV=development
FLASK_DEBUG=1
